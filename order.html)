<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Order Now | Mohazecom Ltd</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background: #f5f5f5;
      margin: 0;
      padding: 0;
    }

    header {
      background: #1d3557;
      color: white;
      text-align: center;
      padding: 1rem;
    }

    nav a {
      margin: 0 10px;
      color: white;
      text-decoration: none;
      font-weight: bold;
    }

    .container {
      max-width: 600px;
      margin: 2rem auto;
      padding: 2rem;
      background: white;
      border-radius: 8px;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    h2 {
      text-align: center;
      color: #1d3557;
    }

    form {
      display: flex;
      flex-direction: column;
    }

    label {
      margin-top: 1rem;
      font-weight: bold;
    }

    input, textarea, select {
      padding: 0.5rem;
      border: 1px solid #ccc;
      border-radius: 5px;
      margin-top: 0.25rem;
    }

    button {
      margin-top: 2rem;
      padding: 0.75rem;
      background: #1d3557;
      color: white;
      border: none;
      border-radius: 5px;
      font-size: 1rem;
      cursor: pointer;
    }

    button:hover {
      background: #16314a;
    }

    footer {
      text-align: center;
      padding: 1rem;
      background: #1d3557;
      color: white;
      margin-top: 3rem;
    }
  </style>
</head>

<body>
  <header>
    <h1>Mohazecom Ltd</h1>
    <nav>
      <a href="index.html">Home</a>
      <a href="phones.html">Phones</a>
      <a href="tvs.html">TVs</a>
      <a href="accessories.html">Accessories</a>
    </nav>
  </header>

  <div class="container">
    <h2>Order Now</h2>
    <form action="https://formspree.io/f/your-form-id" method="POST">
      <label for="product">Product Name</label>
      <input type="text" name="product" id="product" required placeholder="e.g. iPhone 13 Pro Max 256GB" />

      <label for="quantity">Quantity</label>
      <input type="number" name="quantity" id="quantity" min="1" required />

      <label for="name">Full Name</label>
      <input type="text" name="name" id="name" required />

      <label for="phone">Phone Number</label>
      <input type="text" name="phone" id="phone" required />

      <label for="address">Delivery Address</label>
      <textarea name="address" id="address" rows="3" required></textarea>

      <label for="notes">Additional Notes (optional)</label>
      <textarea name="notes" id="notes" rows="2"></textarea>

      <button type="submit">Place Order</button>
    </form>
  </div>

  <footer>
    &copy; 2025 Mohazecom Ltd. All rights reserved.
  </footer>
</body>

</html>
